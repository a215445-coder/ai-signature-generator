# ── 墨签 · AI 艺术签名生成器 配置 ──
# 使用方式：复制本文件为 .env，填入 AI_API_KEY 后保存。

# 服务端口
PORT=3000

# 服务商：siliconflow（推荐，默认）| openai（OpenAI 兼容接口）
PROVIDER=siliconflow

# API Key（必填）
# 硅基流动申请地址：https://cloud.siliconflow.cn/account/ak （手机号注册，支持支付宝）
AI_API_KEY=

# 模型（留空使用默认值 Qwen/Qwen-Image，中英文文字渲染最准确，约 ¥0.3/张）
# 更便宜：Tongyi-MAI/Z-Image-Turbo（约 ¥0.1/张）
# 免费：Kwai-Kolors/Kolors、black-forest-labs/FLUX.1-schnell（中文文字准确度较低）
AI_MODEL=

# 接口地址（一般无需修改；海外网络可改用 https://api.siliconflow.com/v1）
AI_BASE_URL=

# 生成图片尺寸
# Qwen-Image 支持：1328x1328 / 1584x1056 / 1664x928 / 1472x1140 等
AI_IMAGE_SIZE=1584x1056
